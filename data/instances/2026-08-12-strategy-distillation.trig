  # ---------------------------------------------------------------------------
  # August Mission Portfolio baseline (37 candidate missions, pre-Card).
  # Modelled as one Candidate context asset because the source explicitly states these
  # are NOT yet Mission Cards (per-mission DRI, rationale, scope, key path come later).
  # Domain 05's baseline missions were subsequently refined by the FE Domain Mission Card
  # into FE-M1/M2/M3 (see 2026-08-fe-domain-mission-card-candidates.trig).
  # ---------------------------------------------------------------------------
  tkos:strategy-content-august-mission-portfolio-baseline a tkos:StrategyContent ;
    tkos:objectId "strategy-content-august-mission-portfolio-baseline" ;
    tkos:displayName "8 月公司级 Mission Portfolio 基线候选（纲领级，尚未形成 Card）" ;
    tkos:scopeDescription "《Outcome-Mission 展开纲领》列出的候选 Mission（名称 + 8 月底核心结果），按 Domain 分组。01 方向与经营选择：01-1 确认 8 月公司级战略 Outcome；01-2 完成 8 个 Domain 授权；01-3 形成公司级 Mission Portfolio；01-4 形成 9 月后经营判断。02 Transformation：02-1 完成现状诊断与目标 Operating Model；02-2 锁定转型范围、阶段路径与客户协同；02-3 推动一号位与关键角色进入真实运行；02-4 完成首轮价值验证与转型复盘。03 Method：03-1 形成 Outcome-Mission 标准方法；03-2 形成 Mission Card 与质量标准；03-3 完成 8 个 Domain Mission 分解；03-4 完成 DRI 协商与承诺；03-5 建立经营运行节奏；03-6 识别、设计并验证 Work Pattern 候选。04 Agents：04-1 明确首批 Agents 组合与边界；04-2 完成一号位 Application 部署；04-3 形成管理者 Agents 与数字劳动力首批场景；04-4 形成 Mission/决策/Review 工作入口；04-5 建立真实使用与产品迭代闭环。05 Engine & Ontology（纲领版，已被 FE Domain Mission Card 的 FE-M1/M2/M3 细化替代）：05-1 定义 Foundry v0.x 对象与关系；05-2 形成公司与灯塔当前有效 Context；05-3 建立 Context 更新、版本与权限机制；05-4 形成 Engine 最小运行能力；05-5 接通 Agents 并验证边界。06 TokenHub：06-1 完成 MVP 产品与技术定义；06-2 完成核心平台开发；06-3 形成基础运行稳定性；06-4 接入内部真实场景。07 人才与组织能力：07-1 锁定核心岗位与招聘优先级；07-2 完成核心候选人招募；07-3 完成核心团队到位；07-4 完成期权与长期激励体系。08 公司运营与保障：08-1 建立基础财务管理体系；08-2 完成办公场地与办公环境建设；08-3 完成研发环境与模型资源保障；08-4 完成设备设施采购；08-5 完成必要合同与合规建设。文档明确：本纲领不替代各 Mission DRI 进一步形成的 Mission Card 与执行计划。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime .
}
