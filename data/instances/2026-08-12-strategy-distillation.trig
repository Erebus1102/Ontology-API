@prefix tkos: <https://ontology.tokenking.ai/tkos#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Batch 1 — Strategy & operating baseline distillation.
# Sources: 2026-08 Outcome-Mission v1.1 (already a SourceRecord), 总体战略定位与阶段路径,
# AI 企业智能决策网络商业模式, 企业 AI 转型 TKOS 设计方案（管理层汇报版）.
# Every assertion is a Candidate in graph-candidate-and-dispute. Nothing is marked Confirmed.
#
# NOTE on DRI modelling (per user review 2026-08-12): Domain DRIs are expressed as ROLES, not
# named individuals. The six role URIs below are typed both as tkos:DirectlyResponsibleRole
# (per the user's instruction "按本体 DirectlyResponsibleRole") and as tkos:Person, because
# RoleAssignmentShape constrains assignmentHolder to sh:class tkos:Person and the shapes file
# is out of scope for this change. They represent role-position accountability whose in-position
# person is pending confirmation.

tkos:graph-candidate-and-dispute {

  # ---------------------------------------------------------------------------
  # Source records (new documents not yet registered)
  # ---------------------------------------------------------------------------
  tkos:source-strategy-positioning-2026-07 a tkos:SourceRecord ;
    tkos:objectId "source-strategy-positioning-2026-07" ;
    tkos:externalSourceIdentifier "urn:tkos:source:business-document:strategy-positioning-and-phased-path-2026-07" ;
    tkos:displayName "词元云集总体战略定位与阶段路径（董事长汇报版｜2026 年 7 月）" ;
    tkos:version "董事长汇报版" ;
    tkos:recordedAt "2026-08-12T00:00:00+08:00"^^xsd:dateTime .

  tkos:source-ai-decision-network-business-model-2026-07 a tkos:SourceRecord ;
    tkos:objectId "source-ai-decision-network-business-model-2026-07" ;
    tkos:externalSourceIdentifier "urn:tkos:source:business-document:ai-enterprise-decision-network-business-model-2026-07" ;
    tkos:displayName "AI 企业智能决策网络商业模式（董事长汇报版｜2026 年 7 月）" ;
    tkos:version "董事长汇报版" ;
    tkos:recordedAt "2026-08-12T00:00:00+08:00"^^xsd:dateTime .

  tkos:source-tkos-design-management-report-2026-08 a tkos:SourceRecord ;
    tkos:objectId "source-tkos-design-management-report-2026-08" ;
    tkos:externalSourceIdentifier "urn:tkos:source:business-document:tkos-design-management-report-vf-2026-08" ;
    tkos:displayName "企业 AI 转型 TKOS 设计方案（管理层汇报版 vf）" ;
    tkos:version "vf" ;
    tkos:recordedAt "2026-08-12T00:00:00+08:00"^^xsd:dateTime .

  # ---------------------------------------------------------------------------
  # DRI role entities (replace named-person DRIs). Double-typed Person + DirectlyResponsibleRole
  # so they can serve as RoleAssignment.assignmentHolder under the current shapes.
  # ---------------------------------------------------------------------------
  tkos:role-ceo a tkos:DirectlyResponsibleRole, tkos:Person ;
    tkos:objectId "role-ceo" ;
    tkos:displayName "CEO 角色（DRI 岗位）" ;
    tkos:scopeDescription "以 CEO 岗位作为直接责任承担方，在位人待确认。用于 Domain 01 方向与经营选择、Domain 02 Transformation（当前 DRI）。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  tkos:role-business-owner a tkos:DirectlyResponsibleRole, tkos:Person ;
    tkos:objectId "role-business-owner" ;
    tkos:displayName "业务负责人角色（DRI 岗位）" ;
    tkos:scopeDescription "以业务负责人岗位作为直接责任承担方，在位人待确认。用于 Method、TokenHub 等域（候选映射，详见各 Domain）。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  tkos:role-product-owner a tkos:DirectlyResponsibleRole, tkos:Person ;
    tkos:objectId "role-product-owner" ;
    tkos:displayName "产品负责人角色（DRI 岗位）" ;
    tkos:scopeDescription "以产品负责人岗位作为直接责任承担方，在位人待确认。用于 Domain 04 Agents。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  tkos:role-data-owner a tkos:DirectlyResponsibleRole, tkos:Person ;
    tkos:objectId "role-data-owner" ;
    tkos:displayName "数据负责人角色（DRI 岗位）" ;
    tkos:scopeDescription "以数据负责人岗位作为直接责任承担方，在位人待确认。用于 Domain 05 Engine & Ontology（候选映射）。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  tkos:role-finance-owner a tkos:DirectlyResponsibleRole, tkos:Person ;
    tkos:objectId "role-finance-owner" ;
    tkos:displayName "财务负责人角色（DRI 岗位）" ;
    tkos:scopeDescription "以财务负责人岗位作为直接责任承担方，在位人待确认。用于 Domain 08 公司运营与保障。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  tkos:role-hr-owner a tkos:DirectlyResponsibleRole, tkos:Person ;
    tkos:objectId "role-hr-owner" ;
    tkos:displayName "人力负责人角色（DRI 岗位）" ;
    tkos:scopeDescription "以人力负责人岗位作为直接责任承担方，在位人待确认。用于 Domain 07 人才与组织能力。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  # ---------------------------------------------------------------------------
  # Company vision / business model / barriers
  # ---------------------------------------------------------------------------
  tkos:vision-token-factory-and-paradigm a tkos:CompanyVision ;
    tkos:objectId "vision-token-factory-and-paradigm" ;
    tkos:displayName "建设 AI 时代企业经营范式与 Token 运营中枢" ;
    tkos:scopeDescription "长期愿景：建设系统性 Token 工厂，推动收入从空间、算力升级到 Token 与数字劳动力；词元云集承接第 3-6 层，成为连接智能供给与企业价值的运营中枢。" ;
    tkos:sourcedFrom tkos:source-strategy-positioning-2026-07 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-07-01T00:00:00+08:00"^^xsd:dateTime .

  tkos:businessmodel-ai-decision-network a tkos:BusinessModel ;
    tkos:objectId "businessmodel-ai-decision-network" ;
    tkos:displayName "AI 企业智能决策网络（核心主业务）" ;
    tkos:scopeDescription "客户购买的不是五个孤立 AI 产品，而是一套同时提升判断准确度、战略一致性与经营闭环速度的企业智能系统。以一把手战略源点进入，向管理者矩阵与数字劳动力扩展，形成长期公司身份。" ;
    tkos:sourcedFrom tkos:source-ai-decision-network-business-model-2026-07 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-07-01T00:00:00+08:00"^^xsd:dateTime .

  tkos:businessmodel-tokenops-fde a tkos:BusinessModel ;
    tkos:objectId "businessmodel-tokenops-fde" ;
    tkos:displayName "TokenOps FDE（辅助业务）" ;
    tkos:scopeDescription "辅助业务：获取高频真实负载，训练路由、评测与调优能力，保持轻量验证。文档明确不与核心主业务并列，亦暂不纳入当前 8 个内部 Domain。" ;
    tkos:sourcedFrom tkos:source-strategy-positioning-2026-07, tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-07-01T00:00:00+08:00"^^xsd:dateTime .

  tkos:barrier-five-control-points a tkos:CompetitiveBarrier ;
    tkos:objectId "barrier-five-control-points" ;
    tkos:displayName "词元云集应掌握的五个关键控制点" ;
    tkos:scopeDescription "客户与场景入口、企业智能运行入口、Token 调用关系、模型选择与路由权、结果反馈数据。判断标准：任何新增能力都应强化上述控制点，并沉淀可复用的客户、调用或反馈数据。" ;
    tkos:sourcedFrom tkos:source-strategy-positioning-2026-07 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-07-01T00:00:00+08:00"^^xsd:dateTime .

  # ---------------------------------------------------------------------------
  # Strategic content: ACT and T×Q operating models
  # ---------------------------------------------------------------------------
  tkos:strategy-content-act-model a tkos:StrategyContent ;
    tkos:objectId "strategy-content-act-model" ;
    tkos:displayName "ACT 经营闭环效率模型" ;
    tkos:scopeDescription "经营闭环效率 ∝ Accuracy（判断准确度）× Consistency（战略一致性）÷ Time（闭环周期）。ACT 不是精确财务公式，而是解释新旧经营范式差异的管理框架。" ;
    tkos:sourcedFrom tkos:source-ai-decision-network-business-model-2026-07 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-07-01T00:00:00+08:00"^^xsd:dateTime .

  tkos:strategy-content-tq-model a tkos:StrategyContent ;
    tkos:objectId "strategy-content-tq-model" ;
    tkos:displayName "T×Q 战略闭环模型" ;
    tkos:scopeDescription "战略有效转化效率 ≈ Q（战略判断质量与传导保真度）÷ T（时间损耗）× 闭环频率。用于解释 CEO 战略判断从形成到组织执行再校正的闭环效率。" ;
    tkos:sourcedFrom tkos:source-paradigm-reconstruction-roadshow-2026-07 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-07-01T00:00:00+08:00"^^xsd:dateTime .

  # ---------------------------------------------------------------------------
  # Company Outcome — August first company formation (canonical company outcome).
  # The FE-card company outcome (strategy-loop) is integrated into this one as a contributing
  # component via OutcomeContribution below; see decision #3.
  # ---------------------------------------------------------------------------
  tkos:company-outcome-august-first-formation-2026-08 a tkos:CompanyOutcome ;
    tkos:objectId "company-outcome-august-first-formation-2026-08" ;
    tkos:displayName "8 月底完成词元云集第一次公司成型" ;
    tkos:scopeDescription "到 2026 年 8 月 31 日，词元云集完成第一次公司成型：核心业务由 Transformation 进入灯塔客户真实运行，8 个 Domain 按 Outcome-Mission-DRI 方法运转；一号位与管理者 Agents 形成可用版本，Engine & Ontology 建立最小经营 Context 与运行能力，TokenHub 稳定承接核心调用；核心团队、激励体系和公司基础运营条件基本到位。本 CompanyOutcome 为 8 月公司级总目标的规范主实体，并入 FE 卡先前的战略闭环 CompanyOutcome（company-outcome-tkos-real-strategy-loop-2026-08）作为其战略闭环维度。" ;
    tkos:hasSuccessCriterion tkos:criterion-company-formation-august-2026 ;
    tkos:hasStatus tkos:OutcomeDefined ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1, tkos:source-fe-domain-mission-card-2026-08 ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:criterion-company-formation-august-2026 a tkos:SuccessCriterion ;
    tkos:objectId "criterion-company-formation-august-2026" ;
    tkos:displayName "公司成型 8 月底验收清单（10 项）" ;
    tkos:criterionStatement "8 个 Domain 均有清晰 Outcome、唯一 DRI 与关键 Mission；灯塔形成目标 Operating Model、转型路径、关键角色采用与首轮价值验证；一号位 Application 进入真实稳定使用；Outcome-Mission-DRI 方法真实运行三周并完成三次异常 Review；Engine & Ontology 承载统一 Context、状态、权限与回写；TokenHub MVP 稳定承接内部核心 AI 调用；核心岗位 8 月中旬基本确认、8 月底团队完成实质搭建；第一版期权激励体系完成；办公、设备、研发环境、模型资源与基础财务体系可运行；完成一次公司级验收与复盘并形成 9 月调整决定。" ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 .

  # Structured link integrating the two previously coexisting August CompanyOutcomes.
  tkos:contribution-strategy-loop-to-formation a tkos:OutcomeContribution ;
    tkos:objectId "contribution-strategy-loop-to-formation" ;
    tkos:displayName "FE 卡战略闭环 CompanyOutcome 并入公司成型 CompanyOutcome" ;
    tkos:contributionSource tkos:company-outcome-tkos-real-strategy-loop-2026-08 ;
    tkos:contributionTarget tkos:company-outcome-august-first-formation-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1, tkos:source-fe-domain-mission-card-2026-08 ;
    tkos:recordedAt "2026-08-12T00:00:00+08:00"^^xsd:dateTime ;
    tkos:hasConfirmationStatus tkos:Candidate .

  # ---------------------------------------------------------------------------
  # 8 Domains — reuse domain-fe-2026-08 for Domain 05; create 01,02,03,04,06,07,08
  # ---------------------------------------------------------------------------
  tkos:domain-01-direction-choice-2026-08 a tkos:Domain ;
    tkos:objectId "domain-01-direction-choice-2026-08" ;
    tkos:displayName "Domain 01 · 方向与经营选择" ;
    tkos:scopeDescription "确定阶段战略、Company Outcome 与公司级 Mission Portfolio，持续校准经营方向。DRI 角色：CEO。跨 Domain 依赖：为全部 Domain 提供统一 Outcome、优先级、资源边界与关键决策。" ;
    tkos:hasOutcome tkos:domain-outcome-01-strategy-portfolio-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:domain-02-transformation-2026-08 a tkos:Domain ;
    tkos:objectId "domain-02-transformation-2026-08" ;
    tkos:displayName "Domain 02 · Transformation" ;
    tkos:scopeDescription "把客户从当前状态带入目标 Operating Model，推动采用并验证价值；负责灯塔项目现状诊断、转型路径与首轮 ACT 改善证据。不定义通用 Method，不替代产品和系统建设。DRI 角色：CEO（当前；未来由 Transformation 负责人逐步承接）。跨 Domain 依赖：为 03/04/05/06 提供真实客户问题、目标 Operating Model、采用反馈与价值证据。" ;
    tkos:hasOutcome tkos:domain-outcome-02-transformation-lighthouse-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:domain-03-method-2026-08 a tkos:Domain ;
    tkos:objectId "domain-03-method-2026-08" ;
    tkos:displayName "Domain 03 · Method" ;
    tkos:scopeDescription "定义 SICO / OMD / MOER、Outcome、Mission、DRI、Review 与 Work Pattern 规则；不由系统字段倒推经营逻辑。DRI 角色：业务负责人（候选映射——Method 在 6 角色集合中无精确对应，暂以业务负责人承接，待确认）。跨 Domain 依赖：为 02/04/05 及全部 Domain 提供经营语义、Mission 标准、Review 规则与 Work Pattern 验证机制。" ;
    tkos:hasOutcome tkos:domain-outcome-03-method-real-run-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:domain-04-agents-2026-08 a tkos:Domain ;
    tkos:objectId "domain-04-agents-2026-08" ;
    tkos:displayName "Domain 04 · Agents" ;
    tkos:scopeDescription "建设一号位 / 管理者 Agent、数字劳动力与角色化工作入口；不承载企业本体和底层 Runtime。统一口径：Agents DRI 承接产品责任，不再设置 Product / Product DRI 平行责任面。DRI 角色：产品负责人。跨 Domain 依赖：为 02/05 提供真实角色入口、使用反馈与产品边界。" ;
    tkos:hasOutcome tkos:domain-outcome-04-agents-real-use-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:domain-06-tokenhub-2026-08 a tkos:Domain ;
    tkos:objectId "domain-06-tokenhub-2026-08" ;
    tkos:displayName "Domain 06 · TokenHub" ;
    tkos:scopeDescription "提供统一模型接入、账户、权限、计量、日志与运行基础；不与 TKOS Engine 混用，不承担客户转型。DRI 角色：业务负责人（候选映射——TokenHub 为模型/Token 基础设施，6 角色集合无精确对应，暂以业务负责人承接，建议后续补充平台/基础设施负责人角色，待确认）。跨 Domain 依赖：为 04/05 及 TokenOps 提供统一模型调用、账户、计量、日志与稳定性。" ;
    tkos:hasOutcome tkos:domain-outcome-06-tokenhub-mvp-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:domain-07-talent-org-2026-08 a tkos:Domain ;
    tkos:objectId "domain-07-talent-org-2026-08" ;
    tkos:displayName "Domain 07 · 人才与组织能力" ;
    tkos:scopeDescription "搭建核心团队与长期激励机制。DRI 角色：人力负责人。跨 Domain 依赖：为 02-06 提供关键人才及时到位并进入真实 Mission。" ;
    tkos:hasOutcome tkos:domain-outcome-07-talent-equity-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:domain-08-operations-2026-08 a tkos:Domain ;
    tkos:objectId "domain-08-operations-2026-08" ;
    tkos:displayName "Domain 08 · 公司运营与保障" ;
    tkos:scopeDescription "提供财务、办公、研发环境、采购与合规保障。DRI 角色：财务负责人（涵盖财务及综合运营）。跨 Domain 依赖：为 05/06/07 及全部 Domain 提供模型、云资源、设备、办公、合同与 Offer 执行条件。" ;
    tkos:hasOutcome tkos:domain-outcome-08-operations-base-2026-08 ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  # ---------------------------------------------------------------------------
  # Domain Outcomes (7 new; reuse domain-outcome-fe-real-context-loop-2026-08 for 05)
  # ---------------------------------------------------------------------------
  tkos:domain-outcome-01-strategy-portfolio-2026-08 a tkos:DomainOutcome ;
    tkos:objectId "domain-outcome-01-strategy-portfolio-2026-08" ;
    tkos:displayName "形成公司统一、清晰且可向下分解的阶段战略" ;
    tkos:scopeDescription "到 8 月底，明确 8 个 Domain 的目标、边界、优先级与资源配置，并通过公司级 Mission Portfolio 持续校准经营方向。" ;
    tkos:supports tkos:company-outcome-august-first-formation-2026-08 ;
    tkos:hasSuccessCriterion tkos:criterion-domain-outcome-01-2026-08 ;
    tkos:hasStatus tkos:OutcomeDefined ;
    tkos:hasConfirmationStatus tkos:Candidate ;
    tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1 ;
    tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime ;
    tkos:validUntil "2026-08-31T23:59:59+08:00"^^xsd:dateTime .

  tkos:criterion-domain-outcome-01-2026-08 a tkos:SuccessCriterion ;
    tkos:objectId "criterion-domain-outcome-01-2026-08" ;
    tkos:displayName "方向与经营选择 Domain 验收证据" ;
    tkos:criterionStatement "8 个 Domain 的 Outcome、DRI、边界与关键 Mission 得到确认；公司级组合形成真实取舍；新增事项能够说明替代哪个既有 Mission。" ;
