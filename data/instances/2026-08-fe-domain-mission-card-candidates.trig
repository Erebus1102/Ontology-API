  tkos:risk-product1-lighthouse-resource-conflict a tkos:Risk ; tkos:objectId "risk-product1-lighthouse-resource-conflict" ; tkos:displayName "产品 1.0 上线与灯塔交付的跨 Domain 资源冲突" ; tkos:scopeDescription "公司基线要求新增事项经过 Mission Portfolio 取舍，说明支持哪个 Outcome、替代哪项既有 Mission、由谁承担 DRI及所需资源。FE 卡片要求资源冲突时优先保护两条真实业务闭环，砍掉未被真实场景消费的能力范围。" ; tkos:sourcedFrom tkos:source-august-outcome-mission-baseline-v1-1, tkos:source-fe-domain-mission-card-2026-08 ; tkos:hasConfirmationStatus tkos:Candidate ; tkos:validFrom "2026-08-11T00:00:00+08:00"^^xsd:dateTime .

