  tkos:rationale-fe-m1 a tkos:MissionRationale ; tkos:objectId "rationale-FE-M1" ; tkos:displayName "用自身验证 TKOS" ;
    tkos:scopeDescription "CEO、方法负责人、产品负责人和各 DRI 的工作 Context 易分散在文档、对话和个人 Agent 中，背景被重复解释，前序研究与 Decision 难以完整进入承接。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 ; tkos:hasConfirmationStatus tkos:PreliminarilyConfirmed ; tkos:confirmedBy tkos:confirmation-rationale-fe-m1-card ; tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime .
  tkos:scope-fe-m1 a tkos:MissionScope ; tkos:objectId "scope-FE-M1" ; tkos:displayName "FE-M1 边界" ;
    tkos:scopeDescription "包括真实议题 Context 蒸馏与确认、必要关联、读取与必要写回、Product 消费接口、调用来源和 Decision 追溯；不承诺一次性 Demo、全公司完整本体、通用 Agent 平台或未经确认数据成为正式现实。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .
  tkos:criterion-fe-m1-green a tkos:SuccessCriterion ; tkos:objectId "criterion-FE-M1-green" ; tkos:displayName "FE-M1 Green" ;
    tkos:criterionStatement "真实议题与验收口径锁定；Product 在关键环节真实调用 Context 并留有记录；关键 Context 经事实确认且可追溯；承接 DRI 继承前序判断与风险；形成业务增益记录和继续使用或调整结论。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .
  tkos:keypath-fe-m1 a tkos:KeyPath ; tkos:objectId "keypath-FE-M1" ; tkos:displayName "锁定场景后以最小 Context 驱动真实消费" ;
    tkos:scopeDescription "先锁真实议题、参与角色和 Green 证据；候选 Context 经事实确认；Product 尽早消费；Decision 后写回理由、Evidence、风险、Hypothesis 与 Re-open 条件。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .

  tkos:rationale-fe-m2 a tkos:MissionRationale ; tkos:objectId "rationale-FE-M2" ; tkos:displayName "验证客户产品基础" ;
    tkos:scopeDescription "将 Context 机制带入真实客户战略问题，识别可复用经营对象与关系、客户特有内容与暂由文档或 RAG 承载的内容，并在授权边界内支撑真实使用。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 ; tkos:hasConfirmationStatus tkos:PreliminarilyConfirmed ; tkos:confirmedBy tkos:confirmation-rationale-fe-m2-card ; tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime .
  tkos:scope-fe-m2 a tkos:MissionScope ; tkos:objectId "scope-FE-M2" ; tkos:displayName "FE-M2 边界" ;
    tkos:scopeDescription "包括授权范围内的 Context 蒸馏、确认、消费、必要写回、核心关系映射、最小访问控制与迁移性复盘；不承诺独立完整本体、未经授权接入客户数据或带入内部公司 Context。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .
  tkos:criterion-fe-m2-green a tkos:SuccessCriterion ; tkos:objectId "criterion-FE-M2-green" ; tkos:displayName "FE-M2 Green" ;
    tkos:criterionStatement "真实客户议题、授权范围、事实确认方式与验收口径锁定；Product 在客户流程真实消费 Context；客户事实经授权人员确认；前序研究与 Decision 可进入承接；形成通用、客户特有与文档-RAG 边界的迁移结论。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .
  tkos:keypath-fe-m2 a tkos:KeyPath ; tkos:objectId "keypath-FE-M2" ; tkos:displayName "从受控确认开始，在真实消费中识别迁移边界" ;
    tkos:scopeDescription "先锁议题、授权边界和当前工作方式，再带入 M1 核心关系；受控人工确认后逐步自动化；将不可复用点归类为模型缺口、客户 Context、产品交互、方法流程或组织授权。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .

  tkos:rationale-fe-m3 a tkos:MissionRationale ; tkos:objectId "rationale-FE-M3" ; tkos:displayName "由真实消费倒推最小能力" ;
    tkos:scopeDescription "M1 和 M2 需要稳定 Context；本周期沉淀两条闭环反复用到的部分，未被场景消费的架构需求留在下一阶段。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 ; tkos:hasConfirmationStatus tkos:PreliminarilyConfirmed ; tkos:confirmedBy tkos:confirmation-rationale-fe-m3-card ; tkos:validFrom "2026-08-01T00:00:00+08:00"^^xsd:dateTime .
  tkos:scope-fe-m3 a tkos:MissionScope ; tkos:objectId "scope-FE-M3" ; tkos:displayName "FE-M3 边界" ;
    tkos:scopeDescription "包括最小经营对象与关系、Context Pack、读取与必要写回、来源确认状态与追溯、Product 消费接口、运行日志和最小权限隔离；不承诺完整 RBAC、字段级权限、全量自动更新或未被真实消费的 Schema 扩展。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .
  tkos:criterion-fe-m3-green a tkos:SuccessCriterion ; tkos:objectId "criterion-FE-M3-green" ; tkos:displayName "FE-M3 Green" ;
    tkos:criterionStatement "核心对象与关系由 M1、M2 真实消费倒推，具备来源、状态和确认责任；读取、写回、追溯与消费接口在两个场景真实运行；客户差异由场景 Context 或扩展承载；形成复用、暂不建设与 9 月优先级清单。" ; tkos:sourcedFrom tkos:source-fe-domain-mission-card-2026-08 .
  tkos:keypath-fe-m3 a tkos:KeyPath ; tkos:objectId "keypath-FE-M3" ; tkos:displayName "消费即入选" ;
