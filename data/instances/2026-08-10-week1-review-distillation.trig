    tkos:sourcedFrom tkos:source-week1-domain-dri-review-2026-08-10 ;
    tkos:hasConfirmationStatus tkos:Candidate ; tkos:validFrom "2026-08-10T09:25:00+08:00"^^xsd:dateTime .
