# TKOS Runtime — Mac 本机部署环境变量（复制为 .env 并填写；勿提交真实值）

# ── authN（必填）────────────────────────────────────────────────────
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TKOS_API_KEY=CHANGE_ME_strong_random

# ── 运行时 ───────────────────────────────────────────────────────────
# 启动 SHACL 门禁：装载后本地校验，通过才 /ready 200
TKOS_STARTUP_SHACL=1
# 镜像构建时的 git sha，/version 指纹核对用
TKOS_CODE_SHA=CHANGE_ME

# ── LLM 润色（OpenAI 兼容；方舟 Ark 或 DeepSeek 均可，只换三个值）───
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_AUTH_TOKEN=CHANGE_ME_ark_or_deepseek_key
LLM_MODEL=CHANGE_ME_endpoint_id_or_model
# 润色请求超时（秒，默认 120；须低于 gunicorn --timeout 默认 180）
LLM_TIMEOUT=120
