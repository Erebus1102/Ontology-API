# TKOS Runtime — production env template (ECS pilot, cn-beijing)
# Copy to .env on the ECS host; NEVER commit real values.
# Reference: volcengine-deployment-design.md §16 (env mapping).

# ── authN/authZ (deployment blocker B2) ──────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TKOS_API_KEY=CHANGE_ME_strong_random_32+_bytes

# Optional: per-token purpose scoping (v1.1). Omit for single-key mode.
# TKOS_API_KEYS_JSON={"<token>":{"name":"agent","purposes":["decision_preparation"]}}

# ── runtime behavior ─────────────────────────────────────────────────
# Startup SHACL defense-in-depth (design §5.1): validates loaded graph
# before /ready turns 200. Fail → container never accepts traffic.
TKOS_STARTUP_SHACL=1
# Sensitive partition instances (none currently) — keep 0.
TKOS_INCLUDE_SENSITIVE=0
# git sha at image build time — surfaced by /version (fingerprint check)
TKOS_CODE_SHA=CHANGE_ME_git_sha_at_build

# ── LLM polish chain (方舟 Ark, cn-beijing) ───────────────────────────
# OpenAI-compatible endpoint; same region VPC, data stays in cloud.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_AUTH_TOKEN=CHANGE_ME_ark_api_key
LLM_MODEL=CHANGE_ME_ep-xxxxxxxx_endpoint_id

# ── LLM polish timeout ───────────────────────────────────────────────
# 润色请求超时（秒）。大 pack 的润色（~10K 输入 + 长生成）在方舟上可能
# 超过 30s；默认 120。注意需低于 gunicorn --timeout（默认 180）。
LLM_TIMEOUT=120

# ── gunicorn (design §6.1) — env 覆盖 Dockerfile CMD 默认值 ─────────
# GUNICORN_WORKERS=2  # 2 GiB 主机实测 2 worker 驻留 ~170MiB，无需下调
# GUNICORN_TIMEOUT=180  # 须 > LLM_TIMEOUT + 余量
# GUNICORN_GRACEFUL_TIMEOUT=35
