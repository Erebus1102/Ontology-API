    {"@id":"tkos:Confirmation","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:GovernanceEntity"},"rdfs:label":{"@value":"确认记录","@language":"zh"}},
    {"@id":"tkos:LifecycleStatus","@type":"owl:Class","rdfs:label":{"@value":"生命周期状态","@language":"zh"}},
    {"@id":"tkos:ConfirmationStatus","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:LifecycleStatus"},"rdfs:label":{"@value":"确认状态","@language":"zh"},"owl:equivalentClass":{"@type":"owl:Class","owl:oneOf":{"@list":[{"@id":"tkos:Candidate"},{"@id":"tkos:PreliminarilyConfirmed"},{"@id":"tkos:Confirmed"},{"@id":"tkos:Expired"},{"@id":"tkos:Archived"}]}}},
    {"@id":"tkos:MissionStatus","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:LifecycleStatus"},"rdfs:label":{"@value":"Mission 状态","@language":"zh"},"owl:equivalentClass":{"@type":"owl:Class","owl:oneOf":{"@list":[{"@id":"tkos:MissionEstablished"},{"@id":"tkos:MissionCommitted"},{"@id":"tkos:MissionRunning"},{"@id":"tkos:MissionUnderReview"},{"@id":"tkos:MissionAdjusted"},{"@id":"tkos:MissionPaused"},{"@id":"tkos:MissionClosed"}]}}},
    {"@id":"tkos:OutcomeStatus","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:LifecycleStatus"},"rdfs:label":{"@value":"Outcome 状态","@language":"zh"},"owl:equivalentClass":{"@type":"owl:Class","owl:oneOf":{"@list":[{"@id":"tkos:OutcomeDefined"},{"@id":"tkos:OutcomeRunning"},{"@id":"tkos:OutcomeUnderAcceptance"},{"@id":"tkos:OutcomeAchieved"},{"@id":"tkos:OutcomeAdjusted"},{"@id":"tkos:OutcomeClosed"}]}}},
    {"@id":"tkos:DecisionStatus","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:LifecycleStatus"},"rdfs:label":{"@value":"Decision 状态","@language":"zh"},"owl:equivalentClass":{"@type":"owl:Class","owl:oneOf":{"@list":[{"@id":"tkos:DecisionCandidate"},{"@id":"tkos:DecisionPendingConfirmation"},{"@id":"tkos:DecisionEffective"},{"@id":"tkos:DecisionUnderReview"},{"@id":"tkos:DecisionSuperseded"},{"@id":"tkos:DecisionExpired"}]}}},
    {"@id":"tkos:ReviewConclusion","@type":"owl:Class","rdfs:label":{"@value":"复盘结论","@language":"zh"},"owl:equivalentClass":{"@type":"owl:Class","owl:oneOf":{"@list":[{"@id":"tkos:Continue"},{"@id":"tkos:Adjust"},{"@id":"tkos:Pause"},{"@id":"tkos:Close"},{"@id":"tkos:Escalate"}]}}},
    {"@id":"tkos:ReviewRequiredMission","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:Mission"},"rdfs:label":{"@value":"需要复盘的 Mission","@language":"zh"}},
    {"@id":"tkos:Policy","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:GovernanceEntity"},"rdfs:label":{"@value":"政策与约束","@language":"zh"}},
