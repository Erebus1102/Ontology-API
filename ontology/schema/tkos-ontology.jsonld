  "@graph": [
    {
      "@id": "https://ontology.tokenking.ai/tkos#",
      "@type": "owl:Ontology",
      "rdfs:label": [{"@value": "词元云集 TKOS 经营本体", "@language": "zh"}, {"@value": "TokenKing TKOS Operating Ontology", "@language": "en"}],
      "owl:versionInfo": "2.4.0",
      "rdfs:comment": {"@value": "面向一号位 Agent 的共享核心本体。Operating、Decision Provenance 与 Governance 三个模块共享语义，通过命名图治理企业事实、候选判断、敏感个人记录、推导结果与 Context Pack。覆盖 Method Layer 1、Layer 2。", "@language": "zh"},
      "prov:wasDerivedFrom": {"@id": "https://tokenking.feishu.cn/docx/QRSLdn85zo2ujZxCblVc3e50n2c"},
      "owl:imports": [{"@id": "http://www.w3.org/ns/prov-o#"}, {"@id": "http://www.w3.org/2004/02/skos/core#"}, {"@id":"http://www.w3.org/2006/time#"}, {"@id":"http://www.w3.org/ns/org#"}, {"@id":"http://www.w3.org/ns/odrl/2/"}]
    },

    {"@id":"tkos:BusinessEntity","@type":"owl:Class","rdfs:label":{"@value":"经营对象","@language":"zh"},"rdfs:comment":{"@value":"可被识别、描述、关联和治理的 TKOS 经营对象。","@language":"zh"}},
    {"@id":"tkos:StrategicEntity","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:BusinessEntity"},"rdfs:label":{"@value":"战略对象","@language":"zh"},"rdfs:comment":{"@value":"承载公司现实、战略意图、战略判断、战略选择与战略决策的经营对象。","@language":"zh"}},
    {"@id":"tkos:OperatingEntity","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:BusinessEntity"},"rdfs:label":{"@value":"业务运营对象","@language":"zh"},"rdfs:comment":{"@value":"承载 Outcome、Domain、Mission 与经营运行结构的经营对象。","@language":"zh"}},
    {"@id":"tkos:DecisionProvenanceEntity","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:BusinessEntity"},"rdfs:label":{"@value":"决策溯源对象","@language":"zh"},"rdfs:comment":{"@value":"承载决策、判断、学习、证据关系与可重算画像的经营对象。","@language":"zh"}},
    {"@id":"tkos:GovernanceEntity","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:BusinessEntity"},"rdfs:label":{"@value":"治理对象","@language":"zh"},"rdfs:comment":{"@value":"承载主体、角色、责任承担、政策、确认、版本与知识图分区的经营对象。","@language":"zh"}},
    {"@id":"tkos:Actor","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:GovernanceEntity"},"rdfs:label":{"@value":"主体","@language":"zh"}},
    {"@id":"tkos:HumanActor","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:Actor"},"rdfs:label":{"@value":"人员主体","@language":"zh"}},
    {"@id":"tkos:Agent","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:Actor"},"rdfs:label":{"@value":"智能体","@language":"zh"}},
    {"@id":"tkos:No1Agent","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:Agent"},"rdfs:label":{"@value":"一号位 Agent","@language":"zh"}},
    {"@id":"tkos:ManagerAgent","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:Agent"},"rdfs:label":{"@value":"管理者 Agent","@language":"zh"}},
    {"@id":"tkos:Person","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:HumanActor"},"rdfs:label":{"@value":"人员","@language":"zh"}},
    {"@id":"tkos:DirectlyResponsibleIndividual","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:Actor"},"owl:deprecated":true,"rdfs:comment":{"@value":"V1 兼容类型。V2 以 RoleAssignment 表达人员在 Mission、Decision 或组织中的 DRI 承担关系与有效期。","@language":"zh"},"rdfs:label":{"@value":"直接责任人（DRI，兼容）","@language":"zh"}},

    {"@id":"tkos:ContextAsset","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:BusinessEntity"},"rdfs:label":{"@value":"上下文资产","@language":"zh"},"rdfs:comment":{"@value":"可被引用、验证、复用与治理的经营信息资产。","@language":"zh"}},
    {"@id":"tkos:SourceRecord","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:ContextAsset"},"rdfs:label":{"@value":"来源记录","@language":"zh"}},
