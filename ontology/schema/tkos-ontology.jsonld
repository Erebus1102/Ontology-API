    {"@id":"tkos:Rule_MissionContributesToDomainOutcome","@type":"swrl:Imp","rdfs:label":{"@value":"MissionOutcome 的交付关系推导 Mission 对业务域目标的贡献","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:Mission"},"swrl:argument1":{"@id":"tkos:varMission"}},{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:expects"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varMissionOutcome"}},{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:delivers"},"swrl:argument1":{"@id":"tkos:varMissionOutcome"},"swrl:argument2":{"@id":"tkos:varDomainOutcome"}}]},"swrl:head":{"@list":[{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:contributesTo"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varDomainOutcome"}}]}},
    {"@id":"tkos:Rule_HighRiskRequiresReview","@type":"swrl:Imp","rdfs:label":{"@value":"高风险将 Mission 标记为需要复盘","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:hasRisk"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varRisk"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:HighRisk"},"swrl:argument1":{"@id":"tkos:varRisk"}}]},"swrl:head":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ReviewRequiredMission"},"swrl:argument1":{"@id":"tkos:varMission"}}]}},
    {"@id":"tkos:Rule_EvidenceInsufficientRequiresReview","@type":"swrl:Imp","rdfs:label":{"@value":"证据不足将 Mission 标记为需要复盘","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:hasRuleCondition"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varCondition"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:EvidenceInsufficientCondition"},"swrl:argument1":{"@id":"tkos:varCondition"}}]},"swrl:head":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ReviewRequiredMission"},"swrl:argument1":{"@id":"tkos:varMission"}}]}},
    {"@id":"tkos:Rule_DependencyUnsatisfiedRequiresReview","@type":"swrl:Imp","rdfs:label":{"@value":"关键依赖未满足将 Mission 标记为需要复盘","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:hasRuleCondition"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varCondition"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:DependencyUnsatisfiedCondition"},"swrl:argument1":{"@id":"tkos:varCondition"}}]},"swrl:head":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ReviewRequiredMission"},"swrl:argument1":{"@id":"tkos:varMission"}}]}},
    {"@id":"tkos:Rule_OutcomeDeviationRequiresReview","@type":"swrl:Imp","rdfs:label":{"@value":"目标偏离将 Mission 标记为需要复盘","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:hasRuleCondition"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varCondition"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:OutcomeDeviationCondition"},"swrl:argument1":{"@id":"tkos:varCondition"}}]},"swrl:head":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ReviewRequiredMission"},"swrl:argument1":{"@id":"tkos:varMission"}}]}},
    {"@id":"tkos:Rule_DecisionReviewDueRequiresReview","@type":"swrl:Imp","rdfs:label":{"@value":"决策到复审条件将 Mission 标记为需要复盘","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:hasRuleCondition"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varCondition"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:DecisionReviewDueCondition"},"swrl:argument1":{"@id":"tkos:varCondition"}}]},"swrl:head":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ReviewRequiredMission"},"swrl:argument1":{"@id":"tkos:varMission"}}]}},
    {"@id":"tkos:Rule_MissionReadyForAcceptance","@type":"swrl:Imp","rdfs:label":{"@value":"具备证据支持、复盘结论与确认事件的 Mission 进入可验收状态","@language":"zh"},"swrl:body":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:Mission"},"swrl:argument1":{"@id":"tkos:varMission"}},{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:supportedByEvidence"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varEvidence"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:Evidence"},"swrl:argument1":{"@id":"tkos:varEvidence"}},{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:isReviewedBy"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varReview"}},{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:hasReviewConclusion"},"swrl:argument1":{"@id":"tkos:varReview"},"swrl:argument2":{"@id":"tkos:varConclusion"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ReviewConclusion"},"swrl:argument1":{"@id":"tkos:varConclusion"}},{"@type":"swrl:IndividualPropertyAtom","swrl:propertyPredicate":{"@id":"tkos:confirmedBy"},"swrl:argument1":{"@id":"tkos:varMission"},"swrl:argument2":{"@id":"tkos:varConfirmation"}},{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:ConfirmationEvent"},"swrl:argument1":{"@id":"tkos:varConfirmation"}}]},"swrl:head":{"@list":[{"@type":"swrl:ClassAtom","swrl:classPredicate":{"@id":"tkos:MissionReadyForAcceptance"},"swrl:argument1":{"@id":"tkos:varMission"}}]}}
