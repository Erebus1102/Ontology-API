    {"@id":"tkos:EvidenceInsufficientCondition","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:RuleCondition"},"rdfs:label":{"@value":"证据不足条件","@language":"zh"}},
    {"@id":"tkos:DependencyUnsatisfiedCondition","@type":"owl:Class","rdfs:subClassOf":{"@id":"tkos:RuleCondition"},"rdfs:label":{"@value":"关键依赖未满足条件","@language":"zh"}},
